# =========================================================================
# Copia este archivo a ".env" y completa tus propias credenciales.
# NUNCA subas ".env" a git ni lo compartas — ya está en .gitignore.
# =========================================================================

# Nansen Dashboard -> API Keys (https://app.nansen.ai)

NANSEN_API_KEY="NANSEN API KEY"
TELEGRAM_BOT_TOKEN="TELEGRAM BOT TOKEN"
#TELEGRAM_CHAT_ID="TELEGRAM CHAT ID"


# Mientras pruebas: true = calcula señales pero NO envía nada a Telegram.
# Mientras pruebas: false = calcula señales pero SI envía a Telegram.
DRY_RUN=false

DATABASE_PATH=data/cryptonomy_nansen.sqlite3
# Máximo 5 chains por consulta (límite del Token Screener de Nansen).

CHAINS=ethereum,solana,base,bnb,hyperevm

# --- Filtros de "ruido" aplicados en la propia consulta a Nansen ---
MIN_MARKET_CAP_USD=1000000
MIN_LIQUIDITY_USD=250000
MAX_FDV_MC_RATIO=8
MIN_VOLUME_USD_24H=250000
SCREENER_TIMEFRAME=24h

# --- Tamaño del embudo ---
DISCOVERY_TOP_N=50
VALIDATION_TOP_N=15
MIN_SCORE_TO_ALERT=72
MIN_SCORE_TO_TRACK=55
VALIDATION_COOLDOWN_HOURS=12
DISCOVERY_INTERVAL_MINUTES=30

# Ignora operaciones DEX de smart money por debajo de este monto (ruido)
MIN_TRADE_VALUE_USD=2000

# Si los créditos restantes de Nansen caen por debajo de esto, el bot
# se salta la validación de ese ciclo en vez de arriesgarse a un 402/403.
MIN_CREDITS_REMAINING_TO_RUN=200

REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=4
MAX_PAGES=5
PAGE_SIZE=100
TELEGRAM_DISABLE_PREVIEW=true
LOG_LEVEL=INFO
